# ============================================================================
# DATABASE
# ============================================================================
# PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Providers: Neon, Supabase, Railway, local PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/scuttlewhat

# ============================================================================
# LLM PROVIDERS
# ============================================================================
# OpenAI API key (GPT-4o, GPT-4o-mini)
# Used for: consensus answers, LLM analysis, model comparison
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic API key (Claude Sonnet 4.5)
# Used for: primary consensus model, question answering
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ============================================================================
# DATA SOURCES (SCRAPERS)
# ============================================================================
# Product Hunt API token
# Used for: scraping newly launched products
# Get yours at: https://www.producthunt.com/v2/oauth/applications
PRODUCTHUNT_API_KEY=...

# Twitter/X Bearer Token (API v2)
# Used for: scraping product mentions and launches
# Get yours at: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=...

# ============================================================================
# COMMUNICATION SERVICES
# ============================================================================
# Resend API key (email delivery)
# Used for: sending question updates, digests, verification codes
# Get yours at: https://resend.com/api-keys
RESEND_API_KEY=re_...

# Twilio credentials (SMS delivery)
# Used for: SMS notifications and verification codes
# Get yours at: https://console.twilio.com/
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# INFRASTRUCTURE
# ============================================================================
# Redis connection URL (job queue via BullMQ - optional)
# Used for: background jobs, digest generation
# Providers: Upstash, local Redis
REDIS_URL=redis://localhost:6379

# ============================================================================
# SECURITY & ACCESS CONTROL
# ============================================================================
# Cron job authentication secret
# REQUIRED in production: Protects /api/cron/* endpoints
# Generate with: openssl rand -base64 32
CRON_SECRET=your-random-secret-here

# API access token (Bearer authentication)
# OPTIONAL: If set, all API routes require "Authorization: Bearer <token>"
# RECOMMENDED for production deployments
# Leave unset in development for easier testing
API_ACCESS_TOKEN=api-secret-token

# ============================================================================
# RATE LIMITING
# ============================================================================
# Rate limit window in milliseconds (default: 60000 = 1 minute)
# Controls the time window for counting requests
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per window (default: 60 = 60 req/min)
# Per-IP limit applied to all API routes
# Adjust based on expected traffic and LLM API quotas
RATE_LIMIT_MAX_REQUESTS=60

# ============================================================================
# EXTERNAL DATA SOURCES
# ============================================================================
# Disable Google Trends integration (default: false)
# Set to "true" to skip Google Trends API calls and use deterministic fallback
# Useful when: no internet, rate-limited, or testing demand proxy
GOOGLE_TRENDS_DISABLED=false

# ============================================================================
# APPLICATION
# ============================================================================
# Public-facing URL of your application
# Used for: email links, OAuth callbacks, absolute URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment (development | test | production)
# Affects: logging verbosity, error handling, optimizations
NODE_ENV=development
